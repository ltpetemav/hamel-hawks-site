---
import '../styles/site.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  page: string;
  description?: string;
}
const {
  title,
  page,
  description = 'A century of summer baseball in Hamel, Minnesota. Hamel Hawks · 1926–2026. Class B · North Star League.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/logo-100.png" />
    <link rel="icon" type="image/png" href="/assets/logo-100.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body data-page={page}>
    <Nav page={page} />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Centennial FX: full-screen fireworks canvas mounted globally -->
    <canvas id="hhfx-overlay" aria-hidden="true"></canvas>

    <style is:global>
      #hhfx-overlay {
        position: fixed; inset: 0;
        width: 100vw; height: 100vh;
        pointer-events: none;
        z-index: 9999;
        opacity: 0;
        transition: opacity 600ms ease-out;
      }
      #hhfx-overlay.hhfx-firing { opacity: 1; }

      /* Subtle gold shimmer that runs on any element with .hhfx-shimmer */
      .hhfx-shimmer {
        position: relative;
        overflow: hidden;
      }
      .hhfx-shimmer::after {
        content: '';
        position: absolute; inset: 0;
        background: linear-gradient(110deg,
          transparent 0%,
          transparent 38%,
          rgba(255, 255, 255, 0.35) 50%,
          transparent 62%,
          transparent 100%);
        background-size: 200% 100%;
        animation: hhfx-shimmer-sweep 9s ease-in-out infinite;
        pointer-events: none;
        mix-blend-mode: screen;
      }
      @keyframes hhfx-shimmer-sweep {
        0%   { background-position: 200% 50%; opacity: 0; }
        20%  { opacity: 1; }
        50%  { background-position: -50% 50%; opacity: 1; }
        70%  { opacity: 0; }
        100% { background-position: -50% 50%; opacity: 0; }
      }

      /* Odometer counting state */
      .hhfx-odo.is-counting {
        text-shadow: 0 0 24px rgba(241,230,204,0.5), 0 0 8px rgba(201,163,91,0.7);
        transition: text-shadow 200ms;
      }

      /* Championship banner raise-in (used on the home page banners) */
      .hhfx-banner {
        transform: translateY(-120px) rotate(-2deg);
        opacity: 0;
        transition: transform 700ms cubic-bezier(0.34, 1.56, 0.64, 1),
                    opacity 500ms ease-out;
      }
      .hhfx-banner.is-raised {
        transform: translateY(0) rotate(0deg);
        opacity: 1;
      }
      .hhfx-banner.hhfx-clickable {
        cursor: pointer;
        transition: transform 700ms cubic-bezier(0.34, 1.56, 0.64, 1),
                    opacity 500ms ease-out,
                    box-shadow 200ms;
      }
      .hhfx-banner.hhfx-clickable:hover {
        box-shadow: 0 0 0 4px rgba(201,163,91,0.25), 0 8px 24px rgba(0,0,0,0.3);
      }

      /* Ambient audio toggle button in topbar */
      .hhfx-audio-btn {
        background: transparent; border: 0;
        color: inherit; font: inherit;
        cursor: pointer; padding: 0;
        opacity: 0.55;
        transition: opacity 160ms, color 160ms;
      }
      .hhfx-audio-btn:hover { opacity: 1; color: var(--gold); }
      .hhfx-audio-btn.is-playing { opacity: 1; color: var(--gold); }

      /* Click-fireworks hint on the elements that respond */
      [data-hhfx-click] {
        cursor: pointer;
        transition: filter 200ms;
      }
      [data-hhfx-click]:hover {
        filter: brightness(1.08) drop-shadow(0 0 12px rgba(201,163,91,0.5));
      }
    </style>

    <script>
      // ============================================================
      // Hamel Hawks centennial FX library — shared across all pages.
      // Exposes a small surface on window.HHFX for page-specific hooks.
      // ============================================================
      type Part = {
        x: number; y: number; vx: number; vy: number;
        life: number; maxLife: number; color: string;
      };

      const PALETTE = ['#E0B852', '#D62B26', '#F4ECD6', '#F1D27D'];

      // ---- Audio context (lazy) ----
      let audioCtx: AudioContext | null = null;
      function getCtx(): AudioContext {
        if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        return audioCtx;
      }

      function batCrack() {
        const ctx = getCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(1800, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(50, ctx.currentTime + 0.18);
        gain.gain.setValueAtTime(0.4, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.2);
        osc.connect(gain).connect(ctx.destination);
        osc.start(); osc.stop(ctx.currentTime + 0.21);
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.1, ctx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / data.length);
        const src = ctx.createBufferSource();
        src.buffer = buf;
        const gn = ctx.createGain();
        gn.gain.value = 0.4;
        src.connect(gn).connect(ctx.destination);
        src.start();
      }

      function crowdCheer(durationSec = 1.8) {
        const ctx = getCtx();
        const buf = ctx.createBuffer(1, ctx.sampleRate * durationSec, ctx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) {
          const envIn = Math.min(1, i / (ctx.sampleRate * 0.3));
          const envOut = Math.min(1, (data.length - i) / (ctx.sampleRate * 0.4));
          data[i] = (Math.random() * 2 - 1) * 0.5 * envIn * envOut;
        }
        const src = ctx.createBufferSource();
        src.buffer = buf;
        const filt = ctx.createBiquadFilter();
        filt.type = 'bandpass'; filt.frequency.value = 700; filt.Q.value = 0.8;
        const gain = ctx.createGain(); gain.gain.value = 0.55;
        src.connect(filt).connect(gain).connect(ctx.destination);
        src.start();
      }

      function organCharge() {
        const ctx = getCtx();
        const notes = [261.63, 329.63, 392.00, 523.25, 523.25];
        const lengths = [0.18, 0.18, 0.18, 0.18, 0.45];
        let t = ctx.currentTime;
        for (let i = 0; i < notes.length; i++) {
          const osc1 = ctx.createOscillator();
          const osc2 = ctx.createOscillator();
          osc1.type = 'sawtooth'; osc2.type = 'triangle';
          osc1.frequency.value = notes[i];
          osc2.frequency.value = notes[i] * 2;
          const gain = ctx.createGain();
          gain.gain.setValueAtTime(0, t);
          gain.gain.linearRampToValueAtTime(0.18, t + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.001, t + lengths[i]);
          osc1.connect(gain); osc2.connect(gain);
          gain.connect(ctx.destination);
          osc1.start(t); osc2.start(t);
          osc1.stop(t + lengths[i] + 0.02);
          osc2.stop(t + lengths[i] + 0.02);
          t += lengths[i] + 0.04;
        }
      }

      // ---- Ambient bed (toggle) ----
      let ambientNodes: { src: AudioBufferSourceNode; osc: OscillatorNode } | null = null;
      function startAmbient() {
        const ctx = getCtx();
        const dur = 30;
        const buf = ctx.createBuffer(1, ctx.sampleRate * dur, ctx.sampleRate);
        const data = buf.getChannelData(0);
        let b0 = 0, b1 = 0, b2 = 0;
        for (let i = 0; i < data.length; i++) {
          const white = Math.random() * 2 - 1;
          b0 = 0.99765 * b0 + white * 0.0990460;
          b1 = 0.96300 * b1 + white * 0.2965164;
          b2 = 0.57000 * b2 + white * 1.0526913;
          data[i] = (b0 + b1 + b2 + white * 0.1848) * 0.15;
        }
        const src = ctx.createBufferSource();
        src.buffer = buf; src.loop = true;
        const filt = ctx.createBiquadFilter();
        filt.type = 'lowpass'; filt.frequency.value = 600;
        const gain = ctx.createGain(); gain.gain.value = 0.15;
        src.connect(filt).connect(gain).connect(ctx.destination);
        src.start();
        const osc = ctx.createOscillator();
        osc.type = 'sine'; osc.frequency.value = 130.81;
        const oGain = ctx.createGain(); oGain.gain.value = 0.03;
        osc.connect(oGain).connect(ctx.destination);
        osc.start();
        ambientNodes = { src, osc };
        try { sessionStorage.setItem('hhfx-ambient', '1'); } catch {}
      }
      function stopAmbient() {
        if (!ambientNodes) return;
        try { ambientNodes.src.stop(); } catch {}
        try { ambientNodes.osc.stop(); } catch {}
        ambientNodes = null;
        try { sessionStorage.setItem('hhfx-ambient', '0'); } catch {}
      }

      // ---- Fireworks overlay (page-wide) ----
      const overlay = document.getElementById('hhfx-overlay') as HTMLCanvasElement | null;
      function sizeOverlay() {
        if (!overlay) return;
        const dpr = window.devicePixelRatio || 1;
        overlay.width = window.innerWidth * dpr;
        overlay.height = window.innerHeight * dpr;
        overlay.style.width = window.innerWidth + 'px';
        overlay.style.height = window.innerHeight + 'px';
        const ctx = overlay.getContext('2d');
        if (ctx) { ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.scale(dpr, dpr); }
      }
      window.addEventListener('resize', sizeOverlay);
      if (overlay) sizeOverlay();

      let overlayRunning = false;
      function launchFireworks(shots = 14, opts?: { cheer?: boolean }) {
        if (!overlay || overlayRunning) return;
        overlayRunning = true;
        sizeOverlay();
        overlay.classList.add('hhfx-firing');
        const ctx = overlay.getContext('2d')!;
        const W = window.innerWidth;
        const H = window.innerHeight;
        const parts: Part[] = [];
        const trails: { x: number; y: number; tx: number; ty: number; t0: number; dur: number; color: string }[] = [];

        function shootAt(x: number, y: number, delay: number, color: string) {
          trails.push({ x, y: H + 20, tx: x, ty: y, t0: performance.now() + delay, dur: 700, color });
          setTimeout(() => {
            const n = 60 + Math.floor(Math.random() * 40);
            for (let i = 0; i < n; i++) {
              const a = Math.random() * Math.PI * 2;
              const s = 2 + Math.random() * 5;
              parts.push({
                x, y,
                vx: Math.cos(a) * s, vy: Math.sin(a) * s,
                life: 0, maxLife: 80 + Math.random() * 50,
                color: PALETTE[Math.floor(Math.random() * PALETTE.length)],
              });
            }
            parts.push({ x, y, vx: 0, vy: 0, life: 0, maxLife: 12, color: '#FFFFFF' });
            if (delay === 0 && opts?.cheer !== false) { try { crowdCheer(2.2); } catch {} }
          }, delay + 700);
        }

        for (let i = 0; i < shots; i++) {
          const x = W * (0.1 + Math.random() * 0.8);
          const y = H * (0.15 + Math.random() * 0.4);
          shootAt(x, y, i * 380, PALETTE[i % PALETTE.length]);
        }
        const endTime = performance.now() + shots * 380 + 2500;

        function step() {
          const now = performance.now();
          ctx.fillStyle = 'rgba(8, 21, 42, 0.16)';
          ctx.fillRect(0, 0, W, H);
          for (const tr of trails) {
            if (now < tr.t0) continue;
            const p = Math.min(1, (now - tr.t0) / tr.dur);
            if (p >= 1) continue;
            const yy = tr.y + (tr.ty - tr.y) * p;
            ctx.globalAlpha = 0.5 * (1 - p);
            ctx.fillStyle = tr.color;
            ctx.beginPath(); ctx.arc(tr.x, yy, 2.5, 0, Math.PI * 2); ctx.fill();
            for (let k = 1; k < 4; k++) {
              ctx.globalAlpha = 0.25 * (1 - p) * (1 - k / 5);
              ctx.beginPath(); ctx.arc(tr.x, yy + k * 8, 1.5, 0, Math.PI * 2); ctx.fill();
            }
          }
          for (const p of parts) {
            p.x += p.vx; p.y += p.vy; p.vy += 0.06; p.vx *= 0.99; p.life++;
            const a = 1 - p.life / p.maxLife;
            if (a <= 0) continue;
            ctx.globalAlpha = a;
            ctx.fillStyle = p.color;
            ctx.beginPath(); ctx.arc(p.x, p.y, 2.5, 0, Math.PI * 2); ctx.fill();
          }
          ctx.globalAlpha = 1;
          for (let i = parts.length - 1; i >= 0; i--) {
            if (parts[i].life >= parts[i].maxLife) parts.splice(i, 1);
          }
          if (now < endTime || parts.length > 0) {
            requestAnimationFrame(step);
          } else {
            overlay.classList.remove('hhfx-firing');
            setTimeout(() => {
              ctx.clearRect(0, 0, W, H);
              overlayRunning = false;
            }, 700);
          }
        }
        step();
      }

      // ---- Decade odometer ----
      function countUp(el: HTMLElement, opts?: { duration?: number; suffix?: string }) {
        const target = parseFloat(el.dataset.target ?? '0');
        const start = parseFloat(el.dataset.start ?? '0');
        const duration = opts?.duration ?? 2200;
        const suffix = opts?.suffix ?? el.dataset.suffix ?? '';
        const t0 = performance.now();
        el.classList.add('is-counting');
        function frame(now: number) {
          const p = Math.min(1, (now - t0) / duration);
          const eased = 1 - Math.pow(1 - p, 3);
          const v = Math.round(start + (target - start) * eased);
          el.textContent = String(v) + suffix;
          if (p < 1) requestAnimationFrame(frame);
          else setTimeout(() => el.classList.remove('is-counting'), 600);
        }
        requestAnimationFrame(frame);
      }
      function autoCountOdometers() {
        document.querySelectorAll<HTMLElement>('.hhfx-odo[data-target]').forEach((el) => {
          const obs = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                countUp(el, { duration: parseFloat(el.dataset.duration ?? '2200') });
                obs.disconnect();
              }
            });
          }, { threshold: 0.4 });
          obs.observe(el);
        });
      }
      autoCountOdometers();

      // ---- Championship banner raise-in ----
      function autoRaiseBanners() {
        const banners = document.querySelectorAll<HTMLElement>('.hhfx-banner');
        if (!banners.length) return;
        const first = banners[0];
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              banners.forEach((b, i) => {
                setTimeout(() => b.classList.add('is-raised'), i * 220 + 80);
              });
              obs.disconnect();
            }
          });
        }, { threshold: 0.3 });
        obs.observe(first);
      }
      autoRaiseBanners();

      // ---- Ambient audio toggle (hooks any .hhfx-audio-btn) ----
      function wireAmbientButton(btn: HTMLButtonElement) {
        const updateLabel = () => {
          btn.classList.toggle('is-playing', !!ambientNodes);
          btn.setAttribute('aria-pressed', String(!!ambientNodes));
          btn.setAttribute('aria-label', ambientNodes ? 'Pause ballpark ambience' : 'Play ballpark ambience');
        };
        btn.addEventListener('click', () => {
          if (ambientNodes) stopAmbient();
          else startAmbient();
          updateLabel();
        });
        updateLabel();
      }
      document.querySelectorAll<HTMLButtonElement>('.hhfx-audio-btn').forEach(wireAmbientButton);

      // ---- Brand-mark easter egg (tap 10× in the nav) ----
      const brandMark = document.querySelector<HTMLElement>('.nav .brand-mark');
      if (brandMark) {
        let taps = 0;
        let resetTimer: number | undefined;
        brandMark.addEventListener('click', (e) => {
          // Only count if the click was on the brand mark itself, not the parent link
          e.preventDefault();
          e.stopPropagation();
          taps++;
          window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => { taps = 0; }, 2500);
          if (taps >= 10) {
            taps = 0;
            launchFireworks(20);
            setTimeout(() => organCharge(), 600);
          }
        });
      }

      // ---- Generic click-to-fire hooks (data-hhfx-click="overlay" | "organ" | "crack" | "cheer") ----
      document.querySelectorAll<HTMLElement>('[data-hhfx-click]').forEach((el) => {
        el.addEventListener('click', (e) => {
          const kind = el.dataset.hhfxClick;
          if (kind === 'overlay') {
            launchFireworks(14);
          } else if (kind === 'organ') {
            organCharge();
          } else if (kind === 'crack') {
            batCrack();
          } else if (kind === 'cheer') {
            crowdCheer();
          } else if (kind === 'combo') {
            // monogram combo: small fireworks + organ
            launchFireworks(8);
            setTimeout(() => organCharge(), 400);
          }
        });
      });

      // Expose for pages that want to call FX directly
      (window as any).HHFX = {
        launchFireworks,
        countUp,
        batCrack,
        crowdCheer,
        organCharge,
        startAmbient,
        stopAmbient,
      };

      // Restore ambient if user had it on previously this session
      try {
        if (sessionStorage.getItem('hhfx-ambient') === '1') {
          // Browsers block autoplay before user gesture — only restore on first interaction
          const restore = () => {
            startAmbient();
            document.querySelectorAll<HTMLButtonElement>('.hhfx-audio-btn').forEach((b) => {
              b.classList.add('is-playing');
              b.setAttribute('aria-pressed', 'true');
            });
            window.removeEventListener('click', restore);
            window.removeEventListener('touchstart', restore);
          };
          window.addEventListener('click', restore, { once: true });
          window.addEventListener('touchstart', restore, { once: true });
        }
      } catch {}
    </script>
  </body>
</html>
