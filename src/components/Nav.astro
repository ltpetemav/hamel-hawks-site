---
interface Props {
  page: string;
}
const { page } = Astro.props;

const NAV_ITEMS = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'schedule', label: 'Schedule', href: '/schedule' },
  { id: 'roster', label: 'Roster', href: '/roster' },
  { id: 'stats', label: 'Stats', href: '/stats' },
  { id: 'standings', label: 'Standings', href: '/standings' },
  {
    id: 'about',
    label: 'About',
    submenu: [
      { id: 'field', label: 'The Field', href: '/field' },
      { id: 'sponsors', label: 'Sponsors', href: '/sponsors' },
      { id: 'news', label: 'News', href: '/news' },
    ],
  },
  { id: 'shop', label: 'Shop', href: '/shop' },
  { id: 'contact', label: 'Contact', href: '/contact' },
];

const isAboutChild = ['field', 'sponsors', 'news'].includes(page);

const cta =
  page === 'schedule'
    ? { href: 'webcal://api.team-manager.gc.com/ics-calendar-documents/user/a8f29897-b086-44ca-8daa-76afb14ad179.ics', label: '+ Add to Calendar', cls: 'btn btn-primary' }
    : page === 'shop'
    ? { href: '/shop', label: 'Centennial Merch', cls: 'btn btn-gold' }
    : { href: '/schedule', label: 'Next Game →', cls: 'btn btn-primary' };
---
<div class="topbar">
  <div class="topbar-inner">
    <div class="topbar-left">
      <span class="gold-dot">★</span>
      <span>Hamel, Minnesota · Est. 1926</span>
      <span style="opacity: 0.4">·</span>
      <span>North Star League · Class B</span>
    </div>
    <div class="topbar-right">
      <button class="hhfx-audio-btn" aria-label="Play ballpark ambience" aria-pressed="false" title="Ballpark ambience">🔊 Ballpark</button>
      <a href="https://www.instagram.com/hamelhawks/" target="_blank" rel="noopener">Instagram</a>
      <a href="https://twitter.com/mnhamelhawks" target="_blank" rel="noopener">Twitter</a>
      <a href="https://www.facebook.com/hamelhawks" target="_blank" rel="noopener">Facebook</a>
    </div>
  </div>
</div>

<nav class="nav" id="mainNav">
  <div class="nav-inner">
    <a href="/" class="brand">
      <div class="brand-mark">
        <img src="/assets/logo-100.png" alt="Hamel Hawks 100 Years Logo" loading="eager" />
      </div>
      <div class="brand-text">
        <span class="name">Hamel Hawks</span>
        <span class="sub">100 Years · 1926—2026</span>
      </div>
    </a>
    <div class="navlinks">
      {NAV_ITEMS.map((it) => it.submenu ? (
        <div class="has-sub">
          <a href="#" class={isAboutChild ? 'current' : ''}>{it.label}</a>
          <div class="submenu">
            {it.submenu.map((s) => <a href={s.href}>{s.label}</a>)}
          </div>
        </div>
      ) : (
        <a href={it.href} class={it.id === page ? 'current' : ''}>{it.label}</a>
      ))}
    </div>
    <div class="nav-cta">
      <a href={cta.href} class={cta.cls}>{cta.label}</a>
    </div>
    <button
      class="nav-toggle"
      onclick="document.getElementById('mainNav').classList.toggle('open')"
      aria-label="Menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </div>
</nav>
