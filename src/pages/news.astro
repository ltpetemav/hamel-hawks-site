---
import Base from '../layouts/Base.astro';
import { RECENT_HEADLINES } from '../data/news.ts';
---
<Base title="News · Hamel Hawks" page="news">
  <section class="section section-dark page-hero" style="padding: 70px 0 50px; border-bottom: 1px solid rgba(201,163,91,0.3);">
    <div class="wrap">
      <div class="news-hero">
        <div>
          <div class="eyebrow" style="color: var(--gold);">The Hamel Dispatch</div>
          <h1 class="display" style="color: var(--cream); margin-top: 18px;">News &amp; Notes.</h1>
        </div>
        <div class="news-hero-stamp">Full coverage at hamelhawks.com</div>
      </div>
    </div>
  </section>

  <section class="section" style="padding: 0; background: var(--cream-soft);">
    <div class="wrap" style="padding-top: 60px; padding-bottom: 100px;">
      <div class="news-intro">
        <p class="news-intro-p">
          Game recaps, roster news, and season-long coverage live on the
          official Hawks site. The centennial site here keeps the story-side
          of the program — history, the field, the centennial weekend.
          For the week-to-week, head over.
        </p>
        <a href="https://www.hamelhawks.com/news" target="_blank" rel="noopener" class="btn btn-primary news-cta">
          Read on hamelhawks.com →
        </a>
      </div>

      <div class="news-recent">
        <div class="news-recent-head">
          <h3 class="news-recent-title">RECENT HEADLINES</h3>
          <span class="news-recent-meta">Pulled from hamelhawks.com/news</span>
        </div>
        <div>
          {RECENT_HEADLINES.map((h) => (
            <a href={h.href} target="_blank" rel="noopener" class="hl-row">
              <div class="hl-title">{h.title}</div>
              <span class="hl-arrow">Read →</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .news-hero {
    display: flex; justify-content: space-between;
    align-items: end; flex-wrap: wrap; gap: 20px;
  }
  .news-hero-stamp {
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.22em; color: rgba(241,230,204,0.6); text-transform: uppercase;
  }
  .news-intro {
    background: var(--cream); border: 1px solid var(--rule);
    padding: 36px 40px;
    display: flex; justify-content: space-between; align-items: center;
    gap: 30px; flex-wrap: wrap;
  }
  .news-intro-p {
    font-family: var(--font-serif); font-size: 18px;
    line-height: 1.55; color: var(--ink-soft); max-width: 60ch;
  }
  .news-cta { flex-shrink: 0; }
  .news-recent {
    margin-top: 60px; padding-top: 30px;
    border-top: 4px double var(--navy);
  }
  .news-recent-head {
    display: flex; justify-content: space-between;
    align-items: end; margin-bottom: 20px;
  }
  .news-recent-title {
    font-family: var(--font-display); font-size: 28px;
    color: var(--navy); letter-spacing: 0.04em;
  }
  .news-recent-meta {
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.22em; color: var(--fg-muted); text-transform: uppercase;
  }
  .hl-row {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 20px 4px; gap: 20px;
    border-bottom: 1px solid var(--rule);
    transition: background 160ms;
  }
  .hl-row:hover { background: rgba(201,163,91,0.08); }
  .hl-title {
    font-family: var(--font-serif); font-style: italic;
    font-size: 22px; line-height: 1.25; color: var(--navy);
  }
  .hl-arrow {
    font-family: var(--font-display); font-size: 12px;
    letter-spacing: 0.18em; color: var(--accent); flex-shrink: 0;
  }

  @media (max-width: 720px) {
    .news-intro { padding: 24px 22px; gap: 20px; }
    .news-intro-p { font-size: 16px; }
    .news-recent-head { flex-wrap: wrap; gap: 8px; }
    .news-recent-title { font-size: 22px; }
    .hl-row { padding: 14px 4px; gap: 12px; flex-direction: column; align-items: flex-start; }
    .hl-title { font-size: 18px; }
  }
</style>
