---
import Base from '../layouts/Base.astro';
---
<Base title="Paul Fortin Memorial Field · Hamel Hawks" page="field">
  <section class="field-hero">
    <div class="field-hero-photo"></div>
    <div class="field-hero-grad"></div>
    <div class="field-hero-body">
      <div class="wrap">
        <div class="eyebrow" style="color: var(--gold);">★ Home of Hamel Baseball</div>
        <h1 class="display" style="color: var(--cream); margin-top: 16px; max-width: 14ch;">
          Paul Fortin<br />
          <span style="color: var(--gold); font-style: italic; font-family: var(--font-serif); font-weight: 500; text-transform: none; letter-spacing: -0.01em;">Memorial Field.</span>
        </h1>
        <p class="lede" style="margin-top: 20px; color: rgba(241,230,204,0.85);">
          Home to Hamel baseball for sixty-eight years — and counting.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding: 80px 0; background: var(--cream-soft);">
    <div class="wrap">
      <div class="field-facts-grid">
        <div>
          <div class="eyebrow">The Park</div>
          <h2 class="headline" style="margin-top: 16px;">
            A small ballpark with <em>a hundred-year heartbeat.</em>
          </h2>
          <p class="field-p">
            Built by Paul Fortin — the hardware-store owner who refused to let Hamel lose its baseball team —
            Fortin Field has been the geographic and emotional center of Hawks baseball for the better part of a century.
            Paul, eldest son of Fortin Hardware founder Albert Fortin, ran the family store for his entire life and built
            the Hamel field, then convinced University of Minnesota coach Dick Siebert to send his Gophers west to play in it.
          </p>
          <p class="field-p">
            Paul Fortin passed away in 2007 — the same year Fortin Hardware closed its doors after 88 years.
            The field bears his name in his memory.
          </p>
          <p class="field-p">
            The post-2020 rebuild has been the most ambitious in the field's history: lights in 2021,
            a video scoreboard from the Hamel Lions in 2023, a new grandstand in 2024 — financed by Farmers State Bank
            and dreamed of for 75 years — and a professional-grade Duraedge infield in 2025.
          </p>
          <p class="field-p">
            For the centennial, a new banner climbs the foul pole: <em>"100 Years · A Hamel Tradition."</em>
          </p>
        </div>
        <div>
          <div class="dim-grid">
            <div class="dim-cell"><div class="century dim-num">325'</div><div class="dim-label">Left field line</div></div>
            <div class="dim-cell"><div class="century dim-num">325'</div><div class="dim-label">Right field line</div></div>
            <div class="dim-cell"><div class="century dim-num">360'</div><div class="dim-label">Dead center</div></div>
            <div class="dim-cell"><div class="century dim-num dim-navy">2025</div><div class="dim-label">Duraedge infield</div></div>
            <div class="dim-cell"><div class="century dim-num dim-navy">2024</div><div class="dim-label">New grandstand</div></div>
            <div class="dim-cell"><div class="century dim-num dim-navy">2021</div><div class="dim-label">First lights</div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="wrap">
      <div class="diamond-grid">
        <div>
          <svg viewBox="0 0 400 360" style="width: 100%; height: auto;">
            <path d="M 200 320 L 60 180 A 200 200 0 0 1 340 180 Z" fill="rgba(31,90,55,0.7)" stroke="rgba(201,163,91,0.4)" stroke-width="2" stroke-dasharray="4 4"/>
            <path d="M 200 320 L 130 250 L 200 180 L 270 250 Z" fill="rgba(178,49,40,0.25)" stroke="#E0B852" stroke-width="2"/>
            <rect x="195" y="315" width="10" height="10" transform="rotate(45 200 320)" fill="#F4ECD6"/>
            <rect x="265" y="245" width="10" height="10" transform="rotate(45 270 250)" fill="#F4ECD6"/>
            <rect x="195" y="175" width="10" height="10" transform="rotate(45 200 180)" fill="#F4ECD6"/>
            <rect x="125" y="245" width="10" height="10" transform="rotate(45 130 250)" fill="#F4ECD6"/>
            <circle cx="200" cy="250" r="10" fill="rgba(178,49,40,0.4)" stroke="#E0B852" stroke-width="1"/>
            <text x="80" y="200" font-family="DM Mono" font-size="11" fill="#E0B852" letter-spacing="2">325'</text>
            <text x="194" y="100" font-family="DM Mono" font-size="11" fill="#E0B852" letter-spacing="2" text-anchor="middle">360'</text>
            <text x="305" y="200" font-family="DM Mono" font-size="11" fill="#E0B852" letter-spacing="2">325'</text>
            <g transform="translate(370 30)">
              <circle r="14" fill="none" stroke="rgba(201,163,91,0.4)" stroke-width="1"/>
              <text y="-2" text-anchor="middle" font-family="DM Mono" font-size="10" fill="#E0B852">N</text>
            </g>
            <text x="200" y="345" font-family="Anton" font-size="14" fill="#F4ECD6" text-anchor="middle" letter-spacing="2">HOME</text>
            <circle cx="200" cy="140" r="22" fill="#11266B" stroke="#E0B852" stroke-width="1.5"/>
            <text x="200" y="138" font-family="Anton" font-size="11" fill="#E0B852" text-anchor="middle" letter-spacing="1">HAMEL</text>
            <text x="200" y="150" font-family="DM Mono" font-size="8" fill="#E0B852" text-anchor="middle" letter-spacing="2">100</text>
          </svg>
        </div>
        <div>
          <div class="eyebrow" style="color: var(--gold);">The Layout</div>
          <h2 class="headline" style="color: var(--cream); margin-top: 16px;">
            Pitcher friendly, <em>but the ball travels in July.</em>
          </h2>
          <p class="lede" style="margin-top: 24px;">
            Symmetrical 325-foot lines and a 360-foot fence in dead center. Wind tends to
            push from the left-field corner toward right-center on summer evenings —
            the ball travels in July.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-paper">
    <div class="wrap">
      <div class="eyebrow">Game Day</div>
      <h2 class="headline" style="margin-top: 14px;">Plan your visit.</h2>
      <div class="visit-grid">
        <div class="card visit-card">
          <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
          <div class="visit-kicker">★ Address</div>
          <div class="visit-line">Fortin Field<br />Hamel, MN 55340</div>
          <a href="https://maps.app.goo.gl/T9fLnXeUDwcx6LxD8" target="_blank" rel="noopener" class="visit-link">Open in Maps →</a>
        </div>
        <div class="card visit-card">
          <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
          <div class="visit-kicker">★ Parking</div>
          <div class="visit-line">Free on-site lot.</div>
          <p class="visit-note">Additional street parking on Brockton Lane on rivalry nights.</p>
        </div>
        <div class="card visit-card">
          <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
          <div class="visit-kicker">★ Concessions</div>
          <div class="visit-line">Burgers, brats, beer-garden.</div>
          <p class="visit-note">Cash and card. Open from first pitch to last call.</p>
        </div>
        <div class="card visit-card">
          <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
          <div class="visit-kicker">★ Admission</div>
          <div class="visit-line">Free for kids 12 and under.</div>
          <p class="visit-note">Adults $5 at the gate. Centennial Gala tickets sold separately.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-deep">
    <div class="wrap">
      <div style="text-align: center; max-width: 720px; margin: 0 auto;">
        <div class="eyebrow" style="color: var(--gold); justify-content: center;">A Field, Rebuilt</div>
        <h2 class="headline" style="color: var(--cream); margin-top: 14px;">
          Built for the next <em>hundred summers.</em>
        </h2>
      </div>
      <div class="improve-grid">
        <div class="imp-card"><div class="century imp-year">2021</div><div class="imp-label">★ FIRST LIGHTS</div><p class="imp-note">August 10 — first home game under lights in the program's near-century.</p></div>
        <div class="imp-card"><div class="century imp-year">2023</div><div class="imp-label">VIDEO SCOREBOARD</div><p class="imp-note">Donated by the Hamel Lions. The only one at a Minnesota town team field.</p></div>
        <div class="imp-card"><div class="century imp-year">2024</div><div class="imp-label">★ NEW GRANDSTAND</div><p class="imp-note">June 7 opener — 13–12 win over Maple Plain. Funded jointly with Farmers State Bank.</p></div>
        <div class="imp-card"><div class="century imp-year">2025</div><div class="imp-label">DURAEDGE INFIELD</div><p class="imp-note">Professional-grade surface, installed by Bryan Rock Ballfields.</p></div>
        <div class="imp-card imp-card-centennial"><div class="century imp-year">2026</div><div class="imp-label imp-label-gold">★ CENTENNIAL</div><p class="imp-note imp-note-bright">100-year banner raised. Celebration weekend June 26–28.</p></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .field-hero { position: relative; background: var(--navy-deep); color: var(--cream); overflow: hidden; }
  .field-hero-photo {
    width: 100%; height: 70vh; min-height: 520px;
    background-image: url('/assets/field-drone.avif');
    background-size: cover; background-position: center 30%;
  }
  .field-hero-grad {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(8,21,42,0.35) 0%, rgba(8,21,42,0.15) 40%, rgba(8,21,42,0.95) 100%);
    pointer-events: none;
  }
  .field-hero-body { position: absolute; left: 0; right: 0; bottom: 0; padding: 60px var(--gutter); }
  .field-facts-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 80px; align-items: start;
  }
  @media (max-width: 880px) { .field-facts-grid { grid-template-columns: 1fr; gap: 40px; } }
  .field-p { font-size: 18px; line-height: 1.65; color: var(--ink-soft); margin-top: 18px; }
  .field-p:first-of-type { margin-top: 28px; }
  .dim-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 0; border: 1px solid var(--rule);
  }
  .dim-cell {
    padding: 30px;
    border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
  }
  .dim-cell:nth-child(2n) { border-right: 0; }
  .dim-cell:nth-last-child(-n+2) { border-bottom: 0; }
  .dim-num { font-size: 64px; color: var(--accent); }
  .dim-num.dim-navy { color: var(--navy); }
  .dim-label {
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.22em; color: var(--fg-muted);
    text-transform: uppercase; margin-top: 6px;
  }
  .diamond-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 80px; align-items: center;
  }
  @media (max-width: 880px) { .diamond-grid { grid-template-columns: 1fr; gap: 40px; } }
  .visit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 30px; margin-top: 50px;
  }
  .visit-card { padding: 32px; background: var(--cream-soft); }
  .visit-kicker {
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.22em; color: var(--accent);
    text-transform: uppercase; margin-bottom: 12px;
  }
  .visit-line { font-family: var(--font-serif); font-style: italic; font-size: 22px; line-height: 1.3; }
  .visit-note { margin-top: 10px; color: var(--fg-muted); font-size: 14px; }
  .visit-link {
    display: inline-block; margin-top: 16px;
    font-family: var(--font-display); font-size: 12px;
    letter-spacing: 0.18em; color: var(--accent);
  }
  .improve-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px; margin-top: 60px;
  }
  .imp-card { border: 1px solid rgba(201,163,91,0.3); padding: 28px; }
  .imp-card-centennial { border-color: var(--gold); background: rgba(201,163,91,0.08); }
  .imp-year { font-size: 40px; color: var(--gold); }
  .imp-label {
    font-family: var(--font-display); font-size: 14px;
    letter-spacing: 0.12em; margin-top: 10px; color: var(--cream);
  }
  .imp-label-gold { color: var(--gold); }
  .imp-note { font-size: 14px; color: rgba(241,230,204,0.65); margin-top: 6px; }
  .imp-note-bright { color: rgba(241,230,204,0.85); }

  @media (max-width: 720px) {
    .field-hero-photo { height: 50vh; min-height: 360px; }
    .field-hero-body { padding: 36px 18px; }
    .field-facts-grid { gap: 32px; }
    .field-p { font-size: 16px; line-height: 1.6; margin-top: 14px; }
    .dim-num { font-size: 44px; }
    .dim-cell { padding: 20px; }
    .dim-label { font-size: 10px; }
    .diamond-grid { gap: 32px; }
    .visit-grid { margin-top: 30px; gap: 18px; }
    .visit-card { padding: 24px; }
    .visit-line { font-size: 19px; }
    .improve-grid { gap: 14px; margin-top: 36px; }
    .imp-card { padding: 22px; }
    .imp-year { font-size: 32px; }
  }
</style>
